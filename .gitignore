# Root-level ignore
node_modules/
dist/
*.log
*.log.bak
.DS_Store
*.local.json

# 运行时产物（本地生成，不提交）
.dsh/graph-memory/
.dsh/gateway-log/

# 阶段执行轨迹（append-only JSONL，运行时生成，不入库）
gateway/runtime-data/trajectory/

# night 运行时产物（编排脚本入库，日志/清单不入）
night/log/
night/log-night2/
night/*.out
night/manifest.json
night/SUMMARY.md
night/SUMMARY-night2.md
night/stop-flag
night/.night2.lock
night/commit-msg.txt
night/AUDIT_SUMMARY.md
night/audit-backups/
night/audit-run*.log
night/audit-review-list.md

# Gateway runtime artifacts (运行时产物，不入库)
gateway/runtime-js/runtime-data/
gateway/runtime-js/sessions/
